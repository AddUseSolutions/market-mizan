# Öffentliche API-URL (ohne /api — der Client hängt /api an)
# Lokal:
VITE_API_URL=http://localhost:3001
# Render-Beispiel:
# VITE_API_URL=https://market-mizan-api.onrender.com

# WhatsApp floating button (digits only or with +)
VITE_WHATSAPP_NUMBER=+251941881133

# --- Google (alles kostenlos) — vor dem Frontend-Build setzen ---
#
# 1) Google Analytics 4 (Messwerte, Traffic):
#    https://analytics.google.com → Admin → Create property "Market Mizan"
#    → Data stream → Web → URL https://mmizan.com → Measurement ID (G-XXXXXXXX)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
#
# 2) Google Search Console (Indexierung, keine Ads):
#    https://search.google.com/search-console → Add property → URL prefix https://mmizan.com
#    → Verify with HTML tag → copy the content="..." token:
# VITE_GOOGLE_SITE_VERIFICATION=paste_token_here
#
# 3) Nach Deploy in Search Console:
#    Sitemaps → https://mmizan.com/sitemap-index.xml
#    Optional: URL inspection for https://mmizan.com/
#
# Kein Google Ads / kein bezahltes Ranking nötig. Tag Manager ist optional
# (GA4 gtag reicht; schon in frontend/src/utils/analytics.js).

# Site URL used in sitemap generation
# SITE_URL=https://mmizan.com
# SITEMAP_API_URL=https://market-mizan-api.onrender.com
